Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS y dominio SEO único.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^spiegelau\.com\.pe$ [NC]
  RewriteRule ^ https://spiegelau.com.pe%{REQUEST_URI} [R=301,L]

  # Las carpetas generadas sirven automáticamente su index.html.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]
</IfModule>
